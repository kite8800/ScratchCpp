    "subgroups": {
      "none": [
        { "id": "oi-graph-adj", "icon": "code-branch", "label": "std::vector<int> adj[N];", "code": "std::vector<int> adj[N];", "mode": "line" },
        { "id": "oi-graph-add", "icon": "link", "label": "adj[u].push_back(v);", "code": "adj[u].push_back(v);", "mode": "line" },
        { "id": "oi-graph-add2", "icon": "link", "label": "adj[u].push_back(v); adj[v].push_back(u);", "code": "adj[u].push_back(v);\nadj[v].push_back(u);", "mode": "line" },
        { "id": "oi-graph-edge", "icon": "link", "label": "std::vector<pair<int, int>> edges;", "code": "std::vector<pair<int, int>> edges;", "mode": "line" },
        { "id": "oi-graph-bfs", "icon": "forward", "label": "BFS 模板", "code": "std::queue<int> q;\nq.push(s);\nvis[s] = true;\nwhile (!q.empty()) {\n    int u = q.front(); q.pop();\n    for (int v : adj[u]) {\n        if (!vis[v]) { vis[v] = true; q.push(v); }\n    }\n}", "mode": "line" },
        { "id": "oi-graph-dfs", "icon": "forward", "label": "DFS 模板 void dfs(int u)", "code": "void dfs(int u) {\n    vis[u] = true;\n    for (int v : adj[u]) {\n        if (!vis[v]) dfs(v);\n    }\n}", "mode": "line" },
        { "id": "oi-graph-dij", "icon": "calculator", "label": "Dijkstra 模板", "code": "std::priority_queue<pair<int, int>, std::vector<pair<int, int>>, std::greater<pair<int, int>>> pq;\npq.push({0, s});\nstd::fill(dist, dist + n + 1, INF);\ndist[s] = 0;\nwhile (!pq.empty()) {\n    auto [d, u] = pq.top(); pq.pop();\n    if (d > dist[u]) continue;\n    for (auto [v, w] : adj[u]) {\n        if (dist[v] > dist[u] + w) {\n            dist[v] = dist[u] + w;\n            pq.push({dist[v], v});\n        }\n    }\n}", "mode": "line" },
        { "id": "oi-graph-dsu", "icon": "exchange-alt", "label": "并查集模板", "code": "int fa[N];\nint find(int x) { return fa[x] == x ? x : fa[x] = find(fa[x]); }\nvoid merge(int a, int b) { fa[find(a)] = find(b); }", "mode": "line" }
      ],
      "c": [],
      "cpp": []
    }
