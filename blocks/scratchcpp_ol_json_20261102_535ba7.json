        { "id": "oi-ds-lowbit", "icon": "bolt", "label": "树状数组模板", "code": "int tr[N];\nvoid add(int i, int x) { for (; i <= n; i += i & -i) tr[i] += x; }\nint query(int i) { int s = 0; for (; i; i -= i & -i) s += tr[i]; return s; }", "mode": "line" },
        { "id": "oi-ds-seg", "icon": "code-branch", "label": "线段树模板", "code": "int tr[N << 2];\nvoid build(int p, int l, int r) {\n    if (l == r) { tr[p] = a[l]; return; }\n    int mid = (l + r) >> 1;\n    build(p << 1, l, mid);\n    build(p << 1 | 1, mid + 1, r);\n    tr[p] = tr[p << 1] + tr[p << 1 | 1];\n}", "mode": "line" },
        { "id": "oi-ds-seg-push", "icon": "code-branch", "label": "线段树 pushdown", "code": "void pushdown(int p, int l, int r) {\n    if (tag[p]) {\n        int mid = (l + r) >> 1;\n        tr[p << 1] += tag[p] * (mid - l + 1);\n        tr[p << 1 | 1] += tag[p] * (r - mid);\n        tag[p << 1] += tag[p];\n        tag[p << 1 | 1] += tag[p];\n        tag[p] = 0;\n    }\n}", "mode": "line" }
